{
  "name": "resuxjs",
  "version": "0.3.11",
  "private": false,
  "description": "Resumable web framework with Vue-like SFC routing and a custom SSR/runtime pipeline.",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "keywords": [
    "resux",
    "resumable",
    "framework",
    "ssr",
    "vite",
    "vue",
    "routing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmoudAbdalrhmanMohamed/resux.git"
  },
  "bugs": {
    "url": "https://github.com/MahmoudAbdalrhmanMohamed/resux/issues"
  },
  "homepage": "https://github.com/MahmoudAbdalrhmanMohamed/resux#readme",
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "bin": {
    "resuxjs": "dist/bin.js",
    "resux": "dist/bin.js",
    "create-resux": "dist/create-bin.js",
    "create-resuxjs": "dist/create-bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./node": { "types": "./dist/node.d.ts", "import": "./dist/node.js", "default": "./dist/node.js" },
    "./globals": { "types": "./dist/globals.d.ts", "import": "./dist/globals.js", "default": "./dist/globals.js" },
    "./runtime": { "types": "./dist/runtime/index.d.ts", "import": "./dist/runtime/index.js", "default": "./dist/runtime/index.js" },
    "./runtime/core": { "types": "./dist/runtime/core.d.ts", "import": "./dist/runtime/core.js", "default": "./dist/runtime/core.js" },
    "./runtime/router": { "types": "./dist/runtime/router.d.ts", "import": "./dist/runtime/router.js", "default": "./dist/runtime/router.js" },
    "./runtime/reactivity": { "types": "./dist/runtime/reactivity.d.ts", "import": "./dist/runtime/reactivity.js", "default": "./dist/runtime/reactivity.js" },
    "./runtime/resume": { "types": "./dist/runtime/resume.d.ts", "import": "./dist/runtime/resume.js", "default": "./dist/runtime/resume.js" },
    "./reactivity": { "types": "./dist/reactivity/index.d.ts", "import": "./dist/reactivity/index.js", "default": "./dist/reactivity/index.js" },
    "./compiler": { "types": "./dist/compiler/index.d.ts", "import": "./dist/compiler/index.js", "default": "./dist/compiler/index.js" },
    "./build": { "types": "./dist/build/index.d.ts", "import": "./dist/build/index.js", "default": "./dist/build/index.js" },
    "./create": { "types": "./dist/create.d.ts", "import": "./dist/create.js", "default": "./dist/create.js" },
    "./i18n": { "types": "./dist/i18n/index.d.ts", "import": "./dist/i18n/index.js", "default": "./dist/i18n/index.js" },
    "./ui": { "types": "./dist/ui/index.d.ts", "import": "./dist/ui/index.js", "default": "./dist/ui/index.js" },
    "./icons": { "types": "./dist/icons/index.d.ts", "import": "./dist/icons/index.js", "default": "./dist/icons/index.js" },
    "./fonts": { "types": "./dist/fonts/index.d.ts", "import": "./dist/fonts/index.js", "default": "./dist/fonts/index.js" },
    "./kit": { "types": "./dist/kit/index.d.ts", "import": "./dist/kit/index.js", "default": "./dist/kit/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js", "default": "./dist/core/index.js" },
    "./halal": { "types": "./dist/halal.d.ts", "import": "./dist/halal.js", "default": "./dist/halal.js" },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "npm run typecheck && tsdown && node scripts/prepare-compiler-entry.mjs",
    "test": "vitest run",
    "test:types": "npm run typecheck",
    "test:e2e": "vitest run tests/runtime.test.ts",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "test:build": "npm run build",
    "test:deploy": "npm run verify:deploy-targets",
    "test:bundle": "node scripts/test-bundle.mjs && node scripts/report-runtime-metrics.mjs --check",
    "report:runtime": "node scripts/report-runtime-metrics.mjs",
    "check:runtime-size": "npm run build && npm run report:runtime -- --check",
    "verify:vercel-output": "npm run build && node scripts/verify-vercel-output.mjs",
    "verify:deploy-targets": "npm run build && node scripts/verify-deploy-targets.mjs",
    "verify:dependencies": "node scripts/verify-dependency-baseline.mjs",
    "verify:package": "node scripts/verify-package-contract.mjs",
    "quality": "npm run verify:dependencies && npm run build && npm test && npm run test:bundle && npm run test:fixtures && npm run verify:package",
    "create:local": "npm run build && node dist/bin.js init",
    "pack:check": "npm run verify:dependencies && npm run build && npm test && npm run verify:package && npm pack --dry-run && npm pack --dry-run ./packages/create-resuxjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.42",
    "@vue/compiler-sfc": "^3.5.42",
    "h3": "^1.15.11",
    "nitropack": "~2.13.4",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "^20.14.0",
    "tsdown": "0.19.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "nitropack": {
      "rollup-plugin-visualizer": "6.0.11"
    }
  }
}
