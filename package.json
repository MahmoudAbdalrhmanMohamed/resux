{
  "name": "resuxjs",
  "version": "0.3.0",
  "description": "An experimental full-stack Vue framework with a custom server-rendered resumable runtime, file-based routing, server APIs, composables, modules, and deployment presets.",
  "keywords": [
    "resux",
    "vue",
    "framework",
    "ssr",
    "resumability",
    "full-stack",
    "nitro",
    "vite"
  ],
  "homepage": "https://resuxjs.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmoudAbdalrhmanMohamed/resux.git"
  },
  "bugs": {
    "url": "https://github.com/MahmoudAbdalrhmanMohamed/resux/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "resux": "dist/bin.js",
    "resuxjs": "dist/bin.js",
    "create-resux": "dist/create-bin.js",
    "create-resuxjs": "dist/create-bin.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./create": {
      "types": "./dist/create.d.ts",
      "import": "./dist/create.js",
      "default": "./dist/create.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./reactivity": {
      "types": "./dist/reactivity/index.d.ts",
      "import": "./dist/reactivity/index.js",
      "default": "./dist/reactivity/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js",
      "default": "./dist/compiler/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "import": "./dist/deploy/index.js",
      "default": "./dist/deploy/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n.d.ts",
      "import": "./dist/i18n.js",
      "default": "./dist/i18n.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "import": "./dist/media.js",
      "default": "./dist/media.js"
    },
    "./seo": {
      "types": "./dist/seo.d.ts",
      "import": "./dist/seo.js",
      "default": "./dist/seo.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "default": "./dist/config.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js",
      "default": "./dist/module.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "npm run typecheck && node scripts/finalize-build.mjs",
    "test": "vitest run",
    "test:types": "npm run typecheck",
    "test:e2e": "vitest run tests/runtime.test.ts",
    "test:fixtures": "node scripts/test-fixtures.mjs",
    "test:templates": "node scripts/test-templates.mjs",
    "test:build": "npm run build",
    "test:deploy": "npm run verify:deploy-targets",
    "test:bundle": "node scripts/test-bundle.mjs",
    "verify:vercel-output": "npm run build && node scripts/verify-vercel-output.mjs",
    "verify:deploy-targets": "npm run build && node scripts/verify-deploy-targets.mjs",
    "create:local": "npm run build && node dist/cli.js init",
    "pack:check": "npm run build && npm test && npm pack --dry-run"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/compiler-sfc": "^3.5.22",
    "h3": "^1.15.4",
    "nitropack": "^2.12.6",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "vite": "^8.0.10",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "^20.0.10",
    "vitest": "^4.0.8"
  }
}
